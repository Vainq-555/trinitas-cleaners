# Copy to .env and adjust.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
# Used when the web app proxies /api to this server (single-origin cookies).
COOKIE_SECURE=false
# Stripe test-mode credentials only. Never expose these to the web app.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PUBLIC_WEB_URL="http://localhost:3000"

# Password recovery email (Resend). Production values are set via Render env,
# never committed. RESEND_API_KEY is a secret — never print it or ship it.
EMAIL_PROVIDER="resend"
EMAIL_FROM="no-reply@send.trinitaso.com"
EMAIL_REPLY_TO="support@trinitaso.com"
RESEND_API_KEY="re_..."
