// Trinitas-Cleaners — Prisma schema
// Works out of the box on SQLite (zero-setup dev).
// To switch to PostgreSQL: set provider to "postgresql", DATABASE_URL to your
// Postgres DSN, then run `npx prisma migrate dev --name init`.
//
// NOTE: SQLite does not support Prisma native enums, so role/status/type
// fields are Strings validated in the application layer (see
// api/src/utils/validators.js). On PostgreSQL you may convert them to enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  address      String?
  role         String    @default("customer") // "admin" | "customer"
  status       String    @default("offline") // "online" | "offline"
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  // Set when the customer is blocked from posting in the community chat;
  // NULL means the customer may post. Admins clear it to unblock.
  communityBlockedAt DateTime?

  // Stripe Customer identity — the SINGLE source of truth for the customer's
  // recurring-billing identity. NULL until the customer ever pays via "Pay Now"
  // (created lazily by the API after admin accept, never at booking submit).
  stripeCustomerId String? @unique

  // Stripe Customer identity — the SINGLE source of truth for the customer's
  // recurring-billing identity. NULL until the customer ever pays via "Pay Now"
  // (the Stripe Customer is created LAZILY by the API after admin accept, never
  // at booking submit). Do NOT duplicate this on Subscription and do NOT add a
  // StripeCustomer model — User.stripeCustomerId is it.

  subscriptions Subscription[]
  bookings         Booking[]
  receipts         Receipt[]
  reviews          Review[]
  communityMessages CommunityMessage[]
  communityProfile CommunityProfile?
  groupMembers    GroupMember[]
  groupMessages   GroupMessage[]
  groupsOwned     Group[]           @relation("GroupOwner")
  messagesSent   Message[]           @relation("Sender")
  messagesRecv   Message[]           @relation("Receiver")
  customPrices   CustomPrice[]
  broadcastReads UserBroadcastRead[]
  broadcasts     Broadcast[]
  passwordResets PasswordResetToken[]

  @@index([role])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  basePrice   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Monthly recurring billing (approved Option B — true Stripe subscription).
  // monthlyPriceCents is the GLOBAL monthly price in USD cents; NULL means
  // monthly billing is not offered on this service. monthlyActive turns the
  // monthly offer on/off. Per-customer overrides live on CustomPrice
  // (monthlyPriceCents); a non-NULL override always wins over the global value.
  monthlyPriceCents Int?
  monthlyActive     Boolean  @default(false)

  subscriptions  Subscription[]
  bookings       Booking[]
  customPrices   CustomPrice[]
  promotions     PromotionService[]
  contentSections ContentSection[]
  reviews        Review[]
}

// Per-customer price override. Existence of a row overrides basePrice for
// that customer only ("individually target a specific customer account").
model CustomPrice {
  id         String @id @default(cuid())
  serviceId  String
  customerId String
  price      Float

  // Per-customer monthly price override (cents). NULL = use the Service-level
  // global monthlyPriceCents. Two-lane override separate from the one-time
  // legacy Float override above.
  monthlyPriceCents Int?

  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([serviceId, customerId])
}

model Booking {
  id              String     @id @default(cuid())
  customerId      String
  serviceId       String
  date            DateTime
  note            String?
  // "pending" | "accepted" | "declined" | "worked"
  status          String     @default("pending")
  price           Float      // price quoted at booking time (after any override)
  createdAt       DateTime   @default(now())
  archivedAt      DateTime?  // set when a Worked booking is archived; null = active

  // Additive cents snapshot. Legacy Float fields remain unchanged.
  basePriceCents                 Int?
  discountCents                  Int?
  taxableSubtotalCents           Int?
  taxRateBasisPoints             Int?
  taxCents                       Int?
  finalAmountCents               Int?
  taxCalculationId               String?
  taxAddressLine1                String?
  taxAddressLine2                String?
  taxAddressCity                 String?
  taxAddressState                String?
  taxAddressPostalCode           String?
  taxAddressCountry              String?

  // Dedicated booking-level SERVICE LOCATION: where the work is physically
  // performed. Kept separate from the tax-address snapshot above. Optional
  // (nullable) so pre-feature bookings remain valid; new bookings capture it.
  serviceLocationAddressLine1    String?
  serviceLocationAddressLine2    String?
  serviceLocationCity            String?
  serviceLocationState           String?
  serviceLocationPostalCode      String?
  serviceLocationCountry         String?
  serviceLocationInstructions    String?

  // Scheduled appointment start as a UTC instant, derived from the
  // customer-chosen America/Chicago wall-clock date + time. Nullable so
  // pre-feature bookings remain valid; the admin UI always renders it in
  // America/Chicago regardless of the viewer's browser timezone.
  scheduledStartAt               DateTime?

  promotionId                    String?
  promotionCodeSnapshot          String?
  promotionNameSnapshot          String?
  promotionDiscountTypeSnapshot  String?
  promotionDiscountValueSnapshot Int?
  promotionUsageClaimedAt  DateTime?

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id])
  receipts Receipt[]
  payment   Payment?
  review    Review?
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  // Optional back-reference to the subscription this booking originated (the
  // request booking lane). The Subscription owns bookingId — Booking does NOT
  // own subscriptionId.
  subscription Subscription?
  subscriptionBookings SubscriptionBooking[]

  @@index([customerId])
  @@index([promotionId])
  @@index([status])
}

model Payment {
  id                      String    @id @default(cuid())
  bookingId               String    @unique
  method                  String
  status                  String    @default("pending")
  amount                  Float
  amountPaid              Float     @default(0)
  currency                String    @default("usd")
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  failureReason           String?
  paidAt                  DateTime?
  refundedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Authoritative amount for new checkout records. Legacy Float fields remain.
  finalAmountCents        Int?
  amountPaidCents         Int?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  subscriptionPayment SubscriptionPayment?

  @@index([status])
  @@index([method])
}

// Customer ratings on completed bookings. New reviews start as "pending";
// admins approve or reject them; only approved reviews are ever public.
// serviceId is a snapshot/reference to the Service of the reviewed Booking so
// public listings can filter per service without extra joins.
model Review {
  id         String   @id @default(cuid())
  rating     Int      // 1-5, validated in the application layer
  title      String?
  body       String
  // "pending" | "approved" | "rejected"
  status     String   @default("pending")
  customerId String
  bookingId  String   @unique // one review per booking, enforced by the DB
  serviceId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([serviceId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Receipt {
  id         String   @id @default(cuid())
  customerId String
  bookingId  String?
  subtotal   Float
  taxRate    Float    @default(0.0725)
  tax        Float
  discount   Float    @default(0)
  total      Float
  note       String?
  pdfUrl     String?
  createdAt  DateTime @default(now())

  // Authoritative snapshot for receipts created from the new payment path.
  baseAmountCents      Int?
  discountCents        Int?
  taxableSubtotalCents Int?
  taxRateBasisPoints   Int?
  taxCents             Int?
  finalAmountCents     Int?

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model Promotion {
  id               String   @id @default(cuid())
  code             String?  @unique
  name             String
  description      String?
  discountType     String   // "percentage" or "fixed"
  discountValue    Int      // basis points for percentage, cents for fixed
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean  @default(true)
  minSubtotalCents Int?
  priority         Int      @default(0)
  maxUses          Int?
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  services PromotionService[]
  bookings Booking[]
}

model PromotionService {
  promotionId String
  serviceId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([promotionId, serviceId])
  @@index([serviceId])
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

// Customer-to-customer global community chat. Customers post messages visible
// to all other customers; admins moderate (block/unblock via
// User.communityBlockedAt) but never author posts. Blocked customers can still
// read history but their posts are rejected. Deleting a customer account
// removes their posts (same cascade convention as other User children).
model CommunityMessage {
  id         String   @id @default(cuid())
  customerId String
  content    String
  createdAt  DateTime @default(now())

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([customerId])
}

// Customer social identity for the Community feature. 1:1 with User; separate
// from the account so the public profile can never leak account fields. The
// account's User.name is the initial displayName (created lazily on first
// access). admin-only moderation uses moderationHiddenAt (NULL = publicly
// visible); admins may hide/unhide but never edit profile content.
model CommunityProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  displayName        String
  bio                String?
  avatarUrl          String?
  locationCity       String?
  locationState      String?
  showOnline         Boolean   @default(true)
  profileVisible     Boolean   @default(true)
  moderationHiddenAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

// "public" | "private" | "invite_only" — string-validated app-side (G1b+/G1f)
model Group {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  type        String   @default("public")
  // One owner-issued invite code per non-public group (nullable, unique).
  // The owner alone can read/rotate/disable it via the G1f endpoints.
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dissolvedAt DateTime?

  owner    User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  messages GroupMessage[]

  @@index([ownerId])
  @@index([dissolvedAt])
  @@index([createdAt])
  @@index([type])
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id          String    @id @default(cuid())
  groupId     String
  senderId    String
  content     String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([senderId])
}

// "notification" | "announcement"
model Broadcast {
  id        String   @id @default(cuid())
  type      String
  // "public" | "all" | "specific_user"
  target    String
  title     String?
  content   String
  userId    String? // set when target = "specific_user"
  createdAt DateTime @default(now())

  user   User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  readBy UserBroadcastRead[]

  @@index([type])
  @@index([target])
}

model UserBroadcastRead {
  userId      String
  broadcastId String
  readAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@id([userId, broadcastId])
}

// Admin-controlled sections for static marketing pages (e.g. "how-it-works").
// The public API exposes only isActive sections for a whitelisted page slug;
// admins manage the full set via the /admin/content routes.
// serviceId is NULL for global content (multi-service marketing pages such as
// the top-level /how-it-works page) and non-NULL for a single service's own
// "How It Works" steps. The global page query binds serviceId = null, service
// queries bind the specific service, so the two scopes never mix.
model ContentSection {
  id         String   @id @default(cuid())
  page       String
  serviceId  String?
  sectionKey String
  title      String
  body       String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([page, serviceId, sectionKey])
  @@index([serviceId])
  @@index([page])
}

// Admin-controlled business facts shown on the public site (phone, email,
// hours, location, response time). Singleton row keyed by the canonical id
// "business-info". Public API exposes the row as-is; admins edit it via the
// /admin/business-information endpoint. Never holds secrets.
model BusinessInfo {
  id           String    @id // canonical singleton id: "business-info"
  businessName String
  phone        String
  email        String
  addressLine1 String?
  city         String
  state        String
  postalCode   String
  hoursWeek    String
  hoursWeekend String
  responseTime String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Admin-controlled service-area records for the public "Service Areas" page.
// Public API exposes only active areas, ordered by order then name. Deactivating
// (isActive = false) is the primary mechanism; DELETE exists for cleanup only.
model ServiceArea {
  id          String   @id @default(cuid())
  name        String
  city        String
  state       String
  postalCode  String?
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
  @@index([isActive])
}

// Password recovery. Only the SHA-256 hash of the raw reset token is stored;
// the raw token exists solely in the emailed reset URL.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Recurring monthly billing (approved Option B — a TRUE per-service Stripe
// subscription, not a schedule of static one-time bookings).
//
// Identity: the Stripe Customer is User.stripeCustomerId ONLY (single source,
// created lazily by the API after admin accept, never at booking submit) — it is
// NOT duplicated here and no StripeCustomer model exists backgroundColor.
//
// Model shape:
//   Subscription            — one recurring agreement (customer × service).
//   SubscriptionBooking     — one PAID month lane on that subscription (1:1 with
//                             the Booking that that month's payment covers).
//   SubscriptionPayment     — the Payment that paid one month's invoice
//                             (Payment.subscriptionPayment -> this, 1:1).
//
// Period-based billing uses the Booking PERIOD, not calendar months, so a
// subscription never double-bills the struck period the customer actually paid.
// ---------------------------------------------------------------------------

// One recurring billing agreement between a customer and a service. A row is
// created only after the admin ACCEPTS the subscription-request booking (the
// Stripe subscription itself is created lazily at first "Pay Now"). Cancellations
// are a status transition, never a delete — see finalCancelPending /
// finalCancelPendingAt / finalCancelConfirmedAt (the admin-facing "final cancel"
// confirmation gates the destructive/period-finalizing cancel).
model Subscription {
  id                     String    @id @default(cuid())
  customerId             String
  serviceId              String
  bookingId              String    @unique
  months                 Int
  monthCompleted         Int       @default(0)
  status                 String    @default("pending")
  // Monthly price LOCKED at signup (USD cents): the Service/CustomPrice override
  // winner at the moment the subscription was created (never recomputed later).
  monthlyPriceCents      Int
  // Stripe recurring-billing identity; NULL until first "Pay Now" (created lazily).
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?   @unique
  // Webhook-dedup guard, owned by the Subscription (not SubscriptionPayment).
  idempotencyKey         String    @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  // Final-cancel gate (admin confirmation). Pending = cancellation is authorized
  // but the period in progress still completes; ConfirmedAt = the period was
  // finalized and the subscription may be stripped of stripes/lanes.
  finalCancelPending       Boolean   @default(false)
  finalCancelPendingAt     DateTime?
  finalCancelConfirmedAt   DateTime?
  canceledAt               DateTime?
  completedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // The request booking that created this subscription (the "fresh" booking
  // lane). Subscription owns bookingId — Booking does NOT own subscriptionId.
  // Each paid MONTH lives on bookings (SubscriptionBooking) instead.
  booking                Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer               User                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service                Service                  @relation(fields: [serviceId], references: [id])
  bookings               SubscriptionBooking[]
  payments               SubscriptionPayment[]

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
}

// One paid month of a Subscription, 1:1 with the Booking that that month's
// payment actually covered. periodIndex is 1-based within the subscription, so
// [subscriptionId, periodIndex] is unique. Cents snapshots live on the Booking;
// this row only links a booked month to its subscription (and its Payment via
// SubscriptionPayment).
model SubscriptionBooking {
  id              String   @id @default(cuid())
  subscriptionId  String
  bookingId       String   @unique
  periodIndex     Int
  periodStart     DateTime
  periodEnd       DateTime
  stripeInvoiceId String?  @unique
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, periodIndex])
  @@index([subscriptionId])
}

// The Payment (Payment.subscriptionPayment, 1:1) that paid one month on a
// Subscription. One row lands per paid period; the idempotencyKey webhook-dedup
// guard lives on the owning Subscription, not here.
model SubscriptionPayment {
  id              String   @id @default(cuid())
  subscriptionId  String
  paymentId       String   @unique
  periodIndex     Int
  stripeInvoiceId String?  @unique
  status          String   @default("paid")
  refundedAt      DateTime?
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, periodIndex])
  @@index([subscriptionId])
}
