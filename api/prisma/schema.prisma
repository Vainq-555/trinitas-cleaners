// Trinitas-Cleaners — Prisma schema
// Works out of the box on SQLite (zero-setup dev).
// To switch to PostgreSQL: set provider to "postgresql", DATABASE_URL to your
// Postgres DSN, then run `npx prisma migrate dev --name init`.
//
// NOTE: SQLite does not support Prisma native enums, so role/status/type
// fields are Strings validated in the application layer (see
// api/src/utils/validators.js). On PostgreSQL you may convert them to enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  address      String?
  role         String    @default("customer") // "admin" | "customer" | "employee" (no hierarchy)
  status       String    @default("offline") // "online" | "offline"
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  // Set when the customer is blocked from posting in the community chat;
  // NULL means the customer may post. Admins clear it to unblock.
  communityBlockedAt DateTime?

  // EMPLOYEE ACCOUNT LIFECYCLE — additive and separate from `status`.
  // `status` stays presence-only (online/offline heartbeat) and is untouched.
  // disabledAt NULL = account enabled; non-NULL = account disabled by an admin.
  // Disabling NEVER deletes the user and never cascades: the employee identity,
  // their booking assignments and all history remain intact. It is re-read from
  // the database on every authenticated request (never cached in the JWT), so a
  // disable immediately invalidates existing sessions. NULL for every existing
  // customer/admin row, so their behavior is unchanged.
  disabledAt DateTime?

  // Stripe Customer identity — the SINGLE source of truth for the customer's
  // recurring-billing identity. NULL until the customer ever pays via "Pay Now"
  // (created lazily by the API after admin accept, never at booking submit).
  stripeCustomerId String? @unique

  // Stripe Customer identity — the SINGLE source of truth for the customer's
  // recurring-billing identity. NULL until the customer ever pays via "Pay Now"
  // (the Stripe Customer is created LAZILY by the API after admin accept, never
  // at booking submit). Do NOT duplicate this on Subscription and do NOT add a
  // StripeCustomer model — User.stripeCustomerId is it.

  subscriptions Subscription[]
  bookings         Booking[]
  receipts         Receipt[]
  reviews          Review[]
  communityMessages CommunityMessage[]
  // Phase 2B-5 back-relation for the named CommunityMessage moderation relation.
  // Separate from `communityMessages` (which is the AUTHOR side) because the
  // same model references User twice: once as author, once as the admin who
  // removed the post.
  communityMessagesDeleted CommunityMessage[] @relation("CommunityMessageDeletedBy")
  communityProfile CommunityProfile?
  groupMembers    GroupMember[]
  groupMessages   GroupMessage[]
  groupsOwned     Group[]           @relation("GroupOwner")
  messagesSent   Message[]           @relation("Sender")
  messagesRecv   Message[]           @relation("Receiver")
  customPrices   CustomPrice[]
  broadcastReads UserBroadcastRead[]
  broadcasts     Broadcast[]
  passwordResets PasswordResetToken[]

  // Employee-system back-relations (additive). The two BookingAssignment lists
  // are named relations so the same model can reference User twice: the
  // employee who performs the work, and the admin who made the assignment.
  employeeInvitations EmployeeInvitation[]
  employeeAssignments BookingAssignment[]   @relation("AssignedEmployee")
  assignmentsMade     BookingAssignment[]   @relation("AssignedBy")

  // Phase 2B-4 back-relations (additive). Named relations so the same model can
  // reference User more than once: the employee who declared availability, the
  // employee who requested a shift, and the admin who decided/created each one.
  availabilities   EmployeeAvailability[] @relation("AvailabilityEmployee")
  shiftRequests    ShiftRequest[]         @relation("ShiftRequestEmployee")
  shiftOffersMade  ShiftOffer[]           @relation("ShiftOfferCreator")
  shiftDecisions   ShiftRequest[]         @relation("ShiftRequestDecider")
  leaveRequests    EmployeeLeaveRequest[] @relation("LeaveRequestEmployee")
  leaveDecisions   EmployeeLeaveRequest[] @relation("LeaveRequestDecider")

  // Employee RESIGNATION back-relations (additive). Named relations, because
  // EmployeeResignationRequest references User three times over: the employee who
  // resigned, the admin who decided the request, and the admin who acknowledged
  // any outstanding assignments. These are Prisma-level declarations only — they
  // are satisfied entirely by the new table's own foreign keys and generate NO
  // statement against "User" in the migration, so no existing table is altered and
  // NO scalar column is added to User. The resignation record itself is the audit
  // trail; there is deliberately no resignedAt/resignedById on User.
  resignationRequestsAsEmployee           EmployeeResignationRequest[] @relation("ResignationRequestEmployee")
  resignationRequestsAsDecider            EmployeeResignationRequest[] @relation("ResignationRequestDecider")
  resignationRequestsAsOrphanAcknowledger EmployeeResignationRequest[] @relation("ResignationRequestOrphanAcknowledger")

  @@index([role])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  basePrice   Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  // Monthly recurring billing (approved Option B — true Stripe subscription).
  // monthlyPriceCents is the GLOBAL monthly price in USD cents; NULL means
  // monthly billing is not offered on this service. monthlyActive turns the
  // monthly offer on/off. Per-customer overrides live on CustomPrice
  // (monthlyPriceCents); a non-NULL override always wins over the global value.
  monthlyPriceCents Int?
  monthlyActive     Boolean  @default(false)

  subscriptions  Subscription[]
  bookings       Booking[]
  customPrices   CustomPrice[]
  promotions     PromotionService[]
  contentSections ContentSection[]
  reviews        Review[]
}

// Per-customer price override. Existence of a row overrides basePrice for
// that customer only ("individually target a specific customer account").
model CustomPrice {
  id         String @id @default(cuid())
  serviceId  String
  customerId String
  price      Float

  // Per-customer monthly price override (cents). NULL = use the Service-level
  // global monthlyPriceCents. Two-lane override separate from the one-time
  // legacy Float override above.
  monthlyPriceCents Int?

  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([serviceId, customerId])
}

model Booking {
  id              String     @id @default(cuid())
  customerId      String
  serviceId       String
  date            DateTime
  note            String?
  // "pending" | "accepted" | "declined" | "worked"
  status          String     @default("pending")
  price           Float      // price quoted at booking time (after any override)
  createdAt       DateTime   @default(now())
  archivedAt      DateTime?  // set when a Worked booking is archived; null = active

  // Additive cents snapshot. Legacy Float fields remain unchanged.
  basePriceCents                 Int?
  discountCents                  Int?
  taxableSubtotalCents           Int?
  taxRateBasisPoints             Int?
  taxCents                       Int?
  finalAmountCents               Int?
  taxCalculationId               String?
  taxAddressLine1                String?
  taxAddressLine2                String?
  taxAddressCity                 String?
  taxAddressState                String?
  taxAddressPostalCode           String?
  taxAddressCountry              String?

  // Dedicated booking-level SERVICE LOCATION: where the work is physically
  // performed. Kept separate from the tax-address snapshot above. Optional
  // (nullable) so pre-feature bookings remain valid; new bookings capture it.
  serviceLocationAddressLine1    String?
  serviceLocationAddressLine2    String?
  serviceLocationCity            String?
  serviceLocationState           String?
  serviceLocationPostalCode      String?
  serviceLocationCountry         String?
  serviceLocationInstructions    String?

  // Scheduled appointment start as a UTC instant, derived from the
  // customer-chosen America/Chicago wall-clock date + time. Nullable so
  // pre-feature bookings remain valid; the admin UI always renders it in
  // America/Chicago regardless of the viewer's browser timezone.
  scheduledStartAt               DateTime?

  promotionId                    String?
  promotionCodeSnapshot          String?
  promotionNameSnapshot          String?
  promotionDiscountTypeSnapshot  String?
  promotionDiscountValueSnapshot Int?
  promotionUsageClaimedAt  DateTime?

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id])
  receipts Receipt[]
  payment   Payment?
  review    Review?
  promotion Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  // Which employee performs this booking. Additive back-relation only: it does
  // NOT change customerId and does NOT reuse/overwrite scheduledStartAt (the
  // employee's own schedule is BookingAssignment.scheduledStartAt).
  employeeAssignments BookingAssignment[]

  // Phase 2B-4: the optional pool offer for this booking. At most one offer per
  // booking (ShiftOffer.bookingId @unique). PURELY additive — a booking gains no
  // new required field and behaves identically whether or not an offer exists.
  shiftOffer ShiftOffer?

  // Optional back-reference to the subscription this booking originated (the
  // request booking lane). The Subscription owns bookingId — Booking does NOT
  // own subscriptionId.
  subscription Subscription?
  subscriptionBookings SubscriptionBooking[]

  @@index([customerId])
  @@index([promotionId])
  @@index([status])
}

model Payment {
  id                      String    @id @default(cuid())
  bookingId               String    @unique
  method                  String
  status                  String    @default("pending")
  amount                  Float
  amountPaid              Float     @default(0)
  currency                String    @default("usd")
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  failureReason           String?
  paidAt                  DateTime?
  refundedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Authoritative amount for new checkout records. Legacy Float fields remain.
  finalAmountCents        Int?
  amountPaidCents         Int?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  subscriptionPayment SubscriptionPayment?

  @@index([status])
  @@index([method])
}

// Customer ratings on completed bookings. New reviews start as "pending";
// admins approve or reject them; only approved reviews are ever public.
// serviceId is a snapshot/reference to the Service of the reviewed Booking so
// public listings can filter per service without extra joins.
model Review {
  id         String   @id @default(cuid())
  rating     Int      // 1-5, validated in the application layer
  title      String?
  body       String
  // "pending" | "approved" | "rejected"
  status     String   @default("pending")
  customerId String
  bookingId  String   @unique // one review per booking, enforced by the DB
  serviceId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([serviceId])
}

model StripeWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())
}

model Receipt {
  id         String   @id @default(cuid())
  customerId String
  bookingId  String?
  subtotal   Float
  taxRate    Float    @default(0.0725)
  tax        Float
  discount   Float    @default(0)
  total      Float
  note       String?
  pdfUrl     String?
  createdAt  DateTime @default(now())

  // Authoritative snapshot for receipts created from the new payment path.
  baseAmountCents      Int?
  discountCents        Int?
  taxableSubtotalCents Int?
  taxRateBasisPoints   Int?
  taxCents             Int?
  finalAmountCents     Int?

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking  Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([customerId])
}

model Promotion {
  id               String   @id @default(cuid())
  code             String?  @unique
  name             String
  description      String?
  discountType     String   // "percentage" or "fixed"
  discountValue    Int      // basis points for percentage, cents for fixed
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean  @default(true)
  minSubtotalCents Int?
  priority         Int      @default(0)
  maxUses          Int?
  usageCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  services PromotionService[]
  bookings Booking[]
}

model PromotionService {
  promotionId String
  serviceId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([promotionId, serviceId])
  @@index([serviceId])
}

model Message {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
}

// The shared community chat wall. Customers post messages visible to all other
// customers; admins moderate (block/unblock via User.communityBlockedAt) but
// never author posts. Blocked customers can still read history but their posts
// are rejected. Deleting a customer account removes their posts (same cascade
// convention as other User children).
//
// PHASE 2B-5 — ONE TABLE, TWO DISJOINT AUDIENCES.
// Before this phase there was exactly one community and it was customer-only by
// the accident of its route guards. Adding an employee community to the same
// table makes "which audience" a property of the DATA rather than of the route
// that happens to read it, which is the only arrangement in which a customer
// cannot see employee content.
//
// `audience` ("customer" | "employee") — the load-bearing column:
//   * It is NOT NULL DEFAULT 'customer', so it backfills every pre-existing row
//     in place and every customer post keeps exactly the audience it always had.
//   * The default is the SAFE value, so a caller that omits the column creates a
//     CUSTOMER post. An employee post is only ever created by naming the
//     employee audience explicitly.
//   * It is a String, matching this schema's documented convention for
//     role/status/type (SQLite portability; validated in the API layer).
//   * There is deliberately NO value meaning "everybody". A customer query
//     pinned to audience = "customer" can therefore never match an employee row,
//     so the separation fails CLOSED: a dropped or misspelled filter returns an
//     empty feed rather than leaking employee posts to customers.
//
// `customerId` is the AUTHOR foreign key and is deliberately left un-renamed: it
// holds the author id for BOTH audiences, so for audience = "employee" it points
// at an employee. This is the same "one author column, never two" rule the rest
// of this schema follows (Message.senderId, GroupMessage.senderId). Adding a
// second, audience-specific author column would allow the two to disagree.
//
// `deletedAt` / `deletedById` — admin soft delete, mirroring GroupMessage. NULL
// deletedAt = visible. Soft delete (rather than a hard DELETE) means a moderated
// employee post is withdrawn from employees without destroying the record an
// admin needs in order to review the moderation decision. `deletedById` is
// nullable with onDelete: SetNull so removing an admin can never delete a post.
model CommunityMessage {
  id         String   @id @default(cuid())
  customerId String
  content    String
  createdAt  DateTime @default(now())

  // "customer" | "employee" — see the comment above. DEFAULT 'customer'.
  audience String @default("customer")

  // Admin moderation (Phase 2B-5). NULL deletedAt = the post is visible.
  deletedAt   DateTime?
  deletedById String?

  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deletedBy User? @relation("CommunityMessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([customerId])
  // Supports the audience-pinned read every community query performs.
  @@index([audience])
}

// Customer social identity for the Community feature. 1:1 with User; separate
// from the account so the public profile can never leak account fields. The
// account's User.name is the initial displayName (created lazily on first
// access). admin-only moderation uses moderationHiddenAt (NULL = publicly
// visible); admins may hide/unhide but never edit profile content.
model CommunityProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  displayName        String
  bio                String?
  avatarUrl          String?
  locationCity       String?
  locationState      String?
  showOnline         Boolean   @default(true)
  profileVisible     Boolean   @default(true)
  moderationHiddenAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([displayName])
}

// "public" | "private" | "invite_only" — string-validated app-side (G1b+/G1f)
model Group {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  type        String   @default("public")
  // One owner-issued invite code per non-public group (nullable, unique).
  // The owner alone can read/rotate/disable it via the G1f endpoints.
  inviteCode  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dissolvedAt DateTime?

  owner    User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  GroupMember[]
  messages GroupMessage[]

  @@index([ownerId])
  @@index([dissolvedAt])
  @@index([createdAt])
  @@index([type])
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id          String    @id @default(cuid())
  groupId     String
  senderId    String
  content     String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedById String?

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([senderId])
}

// "notification" | "announcement"
model Broadcast {
  id        String   @id @default(cuid())
  type      String
  // "public" | "all" | "specific_user"
  //
  // NOTE: `target` says WHO-WITHIN-AN-AUDIENCE, never which audience. Before
  // Phase 2B-2, target = "all" was effectively "every user who could call
  // /broadcasts/mine" — and that route was requireCustomer, so "all" only ever
  // reached customers by ACCIDENT of the route guard, not by any stored
  // intent. That accident is not a safe contract for a second audience: an
  // employee "all" announcement stored as target = "all" would immediately
  // appear in every customer's feed. `audience` makes the intent explicit.
  target    String
  // WHICH AUDIENCE this belongs to: "customer" | "employee".
  //
  // Additive in Phase 2B-2. Defaults to "customer" so every row that predates
  // the column keeps exactly the behavior it had, and so `target = "all"`
  // continues to mean "all customers" for all existing data — never "everybody".
  // `audience` is orthogonal to `target`, giving the four explicit cases the
  // business asked for:
  //   audience=customer, target=all           -> all customers
  //   audience=customer, target=specific_user -> one customer
  //   audience=employee, target=all           -> all employees
  //   audience=employee, target=specific_user -> one employee
  // A String, matching this schema's existing convention for role/status/type
  // (validated in the application layer, see src/utils/validators.js).
  audience  String   @default("customer")
  title     String?
  content   String
  userId    String? // set when target = "specific_user"
  createdAt DateTime @default(now())

  user   User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  readBy UserBroadcastRead[]

  @@index([type])
  @@index([target])
  @@index([audience])
}

model UserBroadcastRead {
  userId      String
  broadcastId String
  readAt      DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@id([userId, broadcastId])
}

// Admin-controlled sections for static marketing pages (e.g. "how-it-works").
// The public API exposes only isActive sections for a whitelisted page slug;
// admins manage the full set via the /admin/content routes.
// serviceId is NULL for global content (multi-service marketing pages such as
// the top-level /how-it-works page) and non-NULL for a single service's own
// "How It Works" steps. The global page query binds serviceId = null, service
// queries bind the specific service, so the two scopes never mix.
model ContentSection {
  id         String   @id @default(cuid())
  page       String
  serviceId  String?
  sectionKey String
  title      String
  body       String
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@unique([page, serviceId, sectionKey])
  @@index([serviceId])
  @@index([page])
}

// Admin-controlled business facts shown on the public site (phone, email,
// hours, location, response time). Singleton row keyed by the canonical id
// "business-info". Public API exposes the row as-is; admins edit it via the
// /admin/business-information endpoint. Never holds secrets.
model BusinessInfo {
  id           String    @id // canonical singleton id: "business-info"
  businessName String
  phone        String
  email        String
  addressLine1 String?
  city         String
  state        String
  postalCode   String
  hoursWeek    String
  hoursWeekend String
  responseTime String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Admin-controlled service-area records for the public "Service Areas" page.
// Public API exposes only active areas, ordered by order then name. Deactivating
// (isActive = false) is the primary mechanism; DELETE exists for cleanup only.
model ServiceArea {
  id          String   @id @default(cuid())
  name        String
  city        String
  state       String
  postalCode  String?
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
  @@index([isActive])
}

// Password recovery. Only the SHA-256 hash of the raw reset token is stored;
// the raw token exists solely in the emailed reset URL.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// EMPLOYEE SYSTEM — account foundation (Phase 2A).
//
// Employee accounts are ADMIN-created and ADMIN-controlled. They are never
// self-registered (POST /auth/register is hard-wired to the customer role) and
// never self-deleted. "employee" is a separate role with no hierarchy: it
// inherits neither customer nor admin capability.
// ---------------------------------------------------------------------------

// Employee account INVITATION — a dedicated, single-use, expiring credential
// token. Deliberately a SEPARATE model from PasswordResetToken so the security
// semantics are never ambiguous: a password-reset token can never be redeemed
// as an employee invitation, and an invitation can never be redeemed as a
// password reset (the stored digest is additionally purpose-prefixed, see
// utils/employeeInvitation.js).
//
// Security contract:
//   - only the SHA-256 digest of the raw token is persisted;
//   - the raw token exists ONLY inside the emailed activation URL;
//   - single-use: usedAt is stamped on successful activation;
//   - expiring: expiresAt is enforced server-side;
//   - the userId is taken from the token record only, so an activation request
//     can never target a different account;
//   - the raw token is never returned by any API response and never logged.
//
// The invitation only has to survive until the employee sets their first
// password, so it cascades with the user it belongs to (it is meaningless
// without that user). It holds no booking, receipt, customer or payment data,
// so this cascade can never touch any of those.
model EmployeeInvitation {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// WHICH EMPLOYEE PERFORMS A CUSTOMER'S BOOKING — a dedicated first-class
// relation. CRITICAL: Booking.customerId is NEVER reused for employees; the
// customer relationship on a booking stays exactly as it was. Likewise
// Booking.scheduledStartAt is the CUSTOMER's requested/confirmed schedule and is
// never overwritten by an admin assignment — the employee's own scheduled start
// lives on this model (BookingAssignment.scheduledStartAt) so the two concepts
// stay separate:
//     CUSTOMER REQUEST   -> Booking.scheduledStartAt
//     ADMIN EMP SCHEDULE -> BookingAssignment.scheduledStartAt
//
// bookingId is @unique: at most ONE assigned employee per booking, so a booking
// can never be handed to two employees at once (which would leak one employee's
// work to another).
//
// Referential safety (deleting/removing/deactivating an employee must never
// delete a customer's booking, receipt, customer, or any payment/history):
//   - employee  onDelete: SetNull  -> removing an employee row keeps the
//     assignment record and the booking; the work is never cascaded away.
//   - assignedBy onDelete: SetNull -> removing the admin who made the
//     assignment keeps the assignment (nullable) rather than destroying work.
//   - booking   onDelete: Cascade  -> an assignment cannot outlive the booking
//     it belongs to; this cascade only ever removes assignment rows, and
//     booking deletion is pre-existing behavior, not introduced here.
// Disabling an employee (User.disabledAt) touches neither table at all.
model BookingAssignment {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  // Nullable + SetNull so an employee row can never drag an assignment (and
  // therefore a booking) away with it.
  employeeId String?
  // Nullable + SetNull so assignment history survives its admin's removal.
  assignedById String?
  assignedAt DateTime @default(now())
  // The employee's own scheduled start (admin-set). NEVER Booking.scheduledStartAt.
  scheduledStartAt DateTime?
  // Administrative visibility switch for the employee view. Employee reads are
  // always server-scoped to req.user.id AND this flag; it can never widen scope.
  visibleToEmployee Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employee   User?   @relation("AssignedEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  assignedBy User?   @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([assignedById])
}

// ---------------------------------------------------------------------------
// EMPLOYEE AVAILABILITY + AVAILABLE SHIFTS (Phase 2B-4)
//
// BookingAssignment REMAINS the single source of truth for actual work. Nothing
// in this block is an assignment: availability is INFORMATIONAL ("when I can
// work") and a ShiftRequest is a REQUEST ("please give me this one"). The only
// thing that creates real work is a BookingAssignment, which is still written
// exclusively by the existing admin assignment path (POST
// /admin/bookings/:id/assignment) — approving a request calls that same code.
//
// REUSE, NOT DUPLICATION: a "shift" is NOT a new copy of the booking. ShiftOffer
// points at an existing accepted Booking and the service/date/location are always
// read through that relation, so a shift can never disagree with its booking.
// Inspection found no pre-existing availability/shift/shift-request model, so
// these three are genuinely new; nothing existing is duplicated or rewritten.
//
// TIMEZONE: date/startTime/endTime are America/Chicago WALL-CLOCK strings, not
// UTC instants, matching how the customer picks an appointment (utils/schedule.js
// is the single source of truth for that wall clock and for validating these
// formats). Availability is a stated preference, so keeping the wall clock the
// employee actually wrote avoids any lossy instant conversion. A concrete shift
// still has a real instant, and that stays BookingAssignment.scheduledStartAt.
// ---------------------------------------------------------------------------

// One "I can work this window" entry declared by an employee.
//
// Informational only: it NEVER reserves anything and NEVER appears on a
// customer's booking. Strings (not enums) follow the documented schema-wide
// convention for SQLite portability; validity is enforced in the API layer.
model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String
  // America/Chicago wall-clock day, "YYYY-MM-DD" (validated by isValidDateString).
  date       String
  // 24-hour wall-clock window, "HH:MM" (validated by isValidTimeString).
  startTime  String
  endTime    String
  // "available" | "unavailable" — a day the employee has explicitly blocked is
  // represented by the same shape so the two never need separate tables.
  kind       String   @default("available")
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Cascade is correct and intentional here: availability is the employee's own
  // preference data with no operational history, so removing the account removes
  // it. (Unlike BookingAssignment, which uses SetNull so work is never lost.)
  employee User @relation("AvailabilityEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  // Prevents an employee saving the identical window twice by accident, while
  // still allowing several different windows on the same day.
  @@unique([employeeId, date, startTime, endTime, kind])
  @@index([employeeId, date])
}

// An admin-published offer to take a booking. The booking itself is untouched.
model ShiftOffer {
  id          String    @id @default(cuid())
  // At most ONE pool offer per booking, so two admins cannot double-publish the
  // same work and an employee can never see the same shift twice.
  bookingId   String    @unique
  // Employee-facing instructions for this specific work. Admin-private notes are
  // NOT stored here — there is no admin-only note field, so nothing private can
  // leak into the employee view by forgetting to filter it.
  notes       String?
  // Optional cutoff: after this instant the shift is no longer requestable.
  closesAt    DateTime?
  // NULL = created but CLOSED/unpublished (invisible to employees). A non-NULL
  // value is the publication moment and is what makes the shift visible.
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Cascade: an offer cannot outlive the booking it advertises.
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // SetNull: removing the publishing admin must not unpublish the shift.
  createdBy User?   @relation("ShiftOfferCreator", fields: [createdById], references: [id], onDelete: SetNull)
  requests  ShiftRequest[]

  @@index([publishedAt])
}

// An employee's request for a published shift. A request is NOT an assignment.
model ShiftRequest {
  id          String    @id @default(cuid())
  shiftId     String
  employeeId  String
  // "requested" | "approved" | "declined"
  status      String    @default("requested")
  // Optional message from the employee to the admin.
  note        String?
  decidedAt   DateTime?
  decidedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Cascade: the request is meaningless without its shift or its employee.
  shift      ShiftOffer @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  employee   User       @relation("ShiftRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  // SetNull: removing the deciding admin keeps the decision (and its timestamp).
  decidedBy  User?      @relation("ShiftRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  // The duplicate-request guard, enforced by the database rather than by a
  // read-then-write race in application code.
  @@unique([shiftId, employeeId])
  @@index([employeeId, status])
}

// ---------------------------------------------------------------------------
// EMPLOYEE LEAVE REQUESTS
//
// A formal request for time off, approved or declined by an admin. This is a
// SEPARATE system from EmployeeAvailability on purpose, so neither becomes a
// competing source of truth:
//   * EmployeeAvailability — the employee's own stated PREFERENCE ("when I can
//     work"). Informational, approved by nobody, creates no work.
//   * EmployeeLeaveRequest — a REQUEST FOR TIME OFF that only an admin may decide.
// Approving leave deliberately does NOT write an availability row: a preference the
// employee stated and a decision an admin made are different facts, and syncing them
// would let either silently overwrite the other.
//
// A leave request never creates work: BookingAssignment remains the only source of
// truth for an actual assignment, exactly as for a shift request.
// ---------------------------------------------------------------------------
model EmployeeLeaveRequest {
  id         String   @id @default(cuid())
  employeeId String
  // Inclusive calendar-day span as an America/Chicago "YYYY-MM-DD" WALL-CLOCK
  // string — the same convention as EmployeeAvailability.date and the customer
  // appointment picker. A leave day is a day, not an instant, so no UTC conversion
  // (which could shift a leave across a day boundary) is applied.
  // startsOn === endsOn is a genuine ONE-DAY leave.
  startsOn   String
  endsOn     String
  // Optional. NULL is a valid request ("I am off these days"); the buckets are
  // bounded in config.js (LEAVE_KIND) so this column cannot grow free text.
  kind       String?
  note       String?
  // "requested" | "approved" | "declined". A request is only ever "requested" on
  // creation, only an admin approve/decline moves it, and a decided request is
  // never re-decided.
  status     String   @default("requested")
  decidedAt  DateTime?
  decidedById String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  // employeeId CASCADE, matching ShiftRequest.employeeId: a request is meaningless
  // without its employee. Safe for history because an employee User row is NEVER
  // deleted — DELETE /auth/account refuses employee accounts and the admin-only
  // disable clears disabledAt instead of removing the row — so the employee's
  // assignments and history can never cascade away.
  employee   User     @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  // decidedById SET NULL, matching ShiftRequest.decidedById: removing the deciding
  // admin must never erase the decision or its timestamp.
  decidedBy  User?    @relation("LeaveRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  // The employee's own portal list (server-scoped read on every load).
  @@index([employeeId, status])
  // The admin's pending-first queue.
  @@index([status])
}

// ---------------------------------------------------------------------------
// Employee resignation.
//
// A resignation is the employee asking to END the employment relationship. What
// actually changes the account is NOT this row: approving a request transitions
// User.role "employee" -> "customer", so the former employee stays as a normal
// customer and can keep booking. It deliberately does NOT set User.disabledAt:
// disabling is a separate, admin-controlled access lifecycle, and reusing it
// here would wrongly deny a person who is now an ordinary customer.
//
// NO resignedAt / resignedById columns exist on User. This row IS the permanent
// audit record, which is strictly better than a User column: it is queryable,
// it survives the role change, and it can hold the whole decision (who decided,
// when, and why any outstanding work was abandoned).
//
// This model deliberately stores only the COUNT of orphaned assignments plus the
// acknowledgement audit trail — never a relation to Booking or BookingAssignment.
// BookingAssignment remains the sole source of truth for real work.
// ---------------------------------------------------------------------------
model EmployeeResignationRequest {
  id         String   @id @default(cuid())
  employeeId String
  // Optional. NULL is a valid request ("I am resigning"); absence of a note is
  // never a reason to refuse one.
  note       String?
  // "requested" | "approved" | "declined" — exactly three states, mirroring
  // EmployeeLeaveRequest. A request is only ever "requested" on creation; only an
  // admin approve/decline moves it, and a decided request is never re-decided.
  // Approving WITH an orphan acknowledgement is still status "approved": the
  // acknowledgement is expressed by the orphan* columns, never by a fourth status.
  status     String   @default("requested")
  decidedAt  DateTime?
  decidedById String?
  // The number of accepted, non-archived BookingAssignments that still had no
  // replacement when the admin approved. NULL means no override was used at all,
  // which is distinguishable from an override recorded as 0.
  orphanedAssignmentCount Int?
  // WHY the outstanding work was abandoned. Required whenever an override is
  // used (enforced in the API); NULL whenever approval had nothing to override.
  orphanReason String?
  // WHO acknowledged the orphaned assignments and WHEN. Without these the
  // override would record a reason with no actor and no timestamp, which is not
  // an audit trail. All three stay NULL on an ordinary approval.
  orphanAcknowledgedAt   DateTime?
  orphanAcknowledgedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // employeeId CASCADE, matching EmployeeLeaveRequest.employeeId and
  // ShiftRequest.employeeId: a request is meaningless without its employee. This
  // destroys no history, because an employee User row is NEVER deleted — admins
  // disable/reactivate rather than remove, and DELETE /auth/account refuses
  // employee accounts — so assignment history can never cascade away.
  employee User @relation("ResignationRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  // decidedById SET NULL, matching EmployeeLeaveRequest.decidedById: removing the
  // deciding admin must never erase the decision or its timestamp.
  decidedBy User? @relation("ResignationRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  // orphanAcknowledgedById SET NULL for the same reason: an override is an
  // irreversible administrative act, so losing the actor must never delete the
  // record that it happened.
  orphanAcknowledgedBy User? @relation("ResignationRequestOrphanAcknowledger", fields: [orphanAcknowledgedById], references: [id], onDelete: SetNull)

  // DELIBERATELY NO @@unique([employeeId, status]).
  //
  // That constraint would be wrong: it allows only ONE row per status value per
  // employee, so an employee who resigned once (approved) could never resign
  // again — a second "approved" row would collide. Historical approved and
  // declined requests must coexist freely.
  //
  // The real rule is "at most ONE OPEN request per employee", and that is enforced
  // by a PostgreSQL PARTIAL UNIQUE INDEX created in the migration:
  //     CREATE UNIQUE INDEX "EmployeeResignationRequest_employeeId_requested_key"
  //       ON "EmployeeResignationRequest"("employeeId") WHERE "status" = 'requested';
  // Prisma 5.22 cannot model a partial index, so the predicate deliberately lives
  // only in migration SQL. This mirrors the existing ContentSection global-content
  // partial index (20260914000000_add_service_content). The migration SQL is
  // authoritative for this constraint.
  //
  // The employee's own list (server-scoped read on every load).
  @@index([employeeId, status])
  // The admin's pending-first queue.
  @@index([status])
}

// ---------------------------------------------------------------------------
// Recurring monthly billing (approved Option B — a TRUE per-service Stripe
// subscription, not a schedule of static one-time bookings).
//
// Identity: the Stripe Customer is User.stripeCustomerId ONLY (single source,
// created lazily by the API after admin accept, never at booking submit) — it is
// NOT duplicated here and no StripeCustomer model exists backgroundColor.
//
// Model shape:
//   Subscription            — one recurring agreement (customer × service).
//   SubscriptionBooking     — one PAID month lane on that subscription (1:1 with
//                             the Booking that that month's payment covers).
//   SubscriptionPayment     — the Payment that paid one month's invoice
//                             (Payment.subscriptionPayment -> this, 1:1).
//
// Period-based billing uses the Booking PERIOD, not calendar months, so a
// subscription never double-bills the struck period the customer actually paid.
// ---------------------------------------------------------------------------

// One recurring billing agreement between a customer and a service. A row is
// created only after the admin ACCEPTS the subscription-request booking (the
// Stripe subscription itself is created lazily at first "Pay Now"). Cancellations
// are a status transition, never a delete — see finalCancelPending /
// finalCancelPendingAt / finalCancelConfirmedAt (the admin-facing "final cancel"
// confirmation gates the destructive/period-finalizing cancel).
model Subscription {
  id                     String    @id @default(cuid())
  customerId             String
  serviceId              String
  bookingId              String    @unique
  months                 Int
  monthCompleted         Int       @default(0)
  status                 String    @default("pending")
  // Monthly price LOCKED at signup (USD cents): the Service/CustomPrice override
  // winner at the moment the subscription was created (never recomputed later).
  monthlyPriceCents      Int
  // Stripe recurring-billing identity; NULL until first "Pay Now" (created lazily).
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?   @unique
  // Webhook-dedup guard, owned by the Subscription (not SubscriptionPayment).
  idempotencyKey         String    @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  // Final-cancel gate (admin confirmation). Pending = cancellation is authorized
  // but the period in progress still completes; ConfirmedAt = the period was
  // finalized and the subscription may be stripped of stripes/lanes.
  finalCancelPending       Boolean   @default(false)
  finalCancelPendingAt     DateTime?
  finalCancelConfirmedAt   DateTime?
  canceledAt               DateTime?
  completedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // The request booking that created this subscription (the "fresh" booking
  // lane). Subscription owns bookingId — Booking does NOT own subscriptionId.
  // Each paid MONTH lives on bookings (SubscriptionBooking) instead.
  booking                Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer               User                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service                Service                  @relation(fields: [serviceId], references: [id])
  bookings               SubscriptionBooking[]
  payments               SubscriptionPayment[]

  @@index([customerId])
  @@index([serviceId])
  @@index([status])
}

// One paid month of a Subscription, 1:1 with the Booking that that month's
// payment actually covered. periodIndex is 1-based within the subscription, so
// [subscriptionId, periodIndex] is unique. Cents snapshots live on the Booking;
// this row only links a booked month to its subscription (and its Payment via
// SubscriptionPayment).
model SubscriptionBooking {
  id              String   @id @default(cuid())
  subscriptionId  String
  bookingId       String   @unique
  periodIndex     Int
  periodStart     DateTime
  periodEnd       DateTime
  stripeInvoiceId String?  @unique
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, periodIndex])
  @@index([subscriptionId])
}

// The Payment (Payment.subscriptionPayment, 1:1) that paid one month on a
// Subscription. One row lands per paid period; the idempotencyKey webhook-dedup
// guard lives on the owning Subscription, not here.
model SubscriptionPayment {
  id              String   @id @default(cuid())
  subscriptionId  String
  paymentId       String   @unique
  periodIndex     Int
  stripeInvoiceId String?  @unique
  status          String   @default("paid")
  refundedAt      DateTime?
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, periodIndex])
  @@index([subscriptionId])
}
